# Copy to .env and fill in.

# OpenAI — primary. Workshop default is gpt-4o-mini: cheap, capable.
OPENAI_API_KEY=

# Anthropic — optional alternative. Only needed if you override NAVI_MODEL.
# ANTHROPIC_API_KEY=

# Logfire — optional but strongly recommended. Without a token the app still
# runs; you just won't see the tool-call timeline we spend half the workshop on.
LOGFIRE_TOKEN=

# Pick your model. Anything Pydantic AI supports works.
#   openai:gpt-4o-mini       (~$0.15/M in · workshop default)
#   openai:gpt-4o            (~$2.50/M in · use if you want to splurge)
#   anthropic:claude-sonnet-4-5   (needs ANTHROPIC_API_KEY)
NAVI_MODEL=openai:gpt-4o-mini
